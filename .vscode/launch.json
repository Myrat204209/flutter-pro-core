{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "template_app",
            "request": "launch",
            "type": "dart",
            "program": "lib/main.dart",
            "args": [
                "--dart-define=APP_ENV=dev"
            ]
        },
        {
            "name": "template_app (profile mode)",
            "request": "launch",
            "type": "dart",
            "flutterMode": "profile",
            "program": "lib/main.dart",
            "args": [
                "--dart-define=APP_ENV=prod"
            ]
        },
        {
            "name": "template_app (release mode)",
            "request": "launch",
            "type": "dart",
            "flutterMode": "release",
            "program": "lib/main.dart",
            "args": [
                "--dart-define=APP_ENV=prod"
            ]
        }
    ]
}